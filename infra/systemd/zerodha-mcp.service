[Unit]
Description=Zerodha MCP — Personal Trading Intelligence Server
Documentation=file:///home/ubuntu/trading-mcp/infra/README.md
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/trading-mcp

# Load secrets from /etc/zerodha-mcp/.env (owned root:ubuntu, mode 640)
# This file is NEVER committed to git.
EnvironmentFile=/etc/zerodha-mcp/.env

# Structured JSON logs in production (see src/logging_config.py) -- lets
# journald/log shippers parse level/service/request_id instead of a plain
# text line. Overridable per-unit here rather than requiring it in the
# shared .env, since it's an operational default, not a secret.
Environment=LOG_FORMAT=json

# Start the application via uv (manages the venv automatically)
ExecStart=/home/ubuntu/.local/bin/uv run zerodha-mcp

# Restart policy: restart on any failure, with exponential backoff
Restart=on-failure
RestartSec=5s
StartLimitInterval=60s
StartLimitBurst=3

# Graceful shutdown timeout
TimeoutStopSec=30

# Logging — view with: journalctl -u zerodha-mcp -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=zerodha-mcp

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/trading-mcp /home/ubuntu/.cache/uv /home/ubuntu/.local /var/lib/zerodha-mcp
PrivateTmp=true

[Install]
WantedBy=multi-user.target
