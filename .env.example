# =============================================================================
# Zerodha MCP — Environment Variables
# =============================================================================
# Development: copy to .env in the repo root (already in .gitignore).
# Production (Oracle VM): copy to /etc/zerodha-mcp/.env
#
#   sudo mkdir -p /etc/zerodha-mcp
#   sudo cp .env.example /etc/zerodha-mcp/.env
#   sudo nano /etc/zerodha-mcp/.env        # fill in real values
#   sudo chmod 640 /etc/zerodha-mcp/.env
#   sudo chown root:ubuntu /etc/zerodha-mcp/.env
#
# The systemd service loads /etc/zerodha-mcp/.env via EnvironmentFile.
# NEVER commit real secrets to git.
# =============================================================================

# ── Runtime environment ────────────────────────────────────────────────────────
# Values: development | staging | production
ENVIRONMENT=development

# ── PostgreSQL (Oracle VM — native PostgreSQL 17) ─────────────────────────────
# Leave blank on Railway/Windows dev (uses SQLite via JOURNAL_DB/TURSO_DATABASE_URL).
# On the Oracle VM this must be set. asyncpg driver is used automatically.
DATABASE_URL=postgresql+asyncpg://zerodha_app:CHANGE_THIS_PASSWORD@127.0.0.1:5432/zerodha_mcp
# Set to 1 to log all SQL — development only, never in production.
DB_ECHO=0

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_THIS_TO_A_64_CHAR_HEX_SECRET

# ── LLM API keys ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ── Redis (optional — future caching / rate limiting) ─────────────────────────
# REDIS_URL=redis://127.0.0.1:6379/0

# ── Zerodha personal account credentials ──────────────────────────────────────
# Your Zerodha client ID (e.g. ZK1234) and trading password.
# These are only used at login time — never sent to third parties.
ZERODHA_USER_ID=your_client_id
ZERODHA_PASSWORD=your_password

# TOTP — provide ONE of the following:
#   TOTP_SECRET  base32 secret from Zerodha's 2FA QR code (recommended for
#                unattended servers — the server generates the code automatically)
#   Leave blank if you prefer to pass the 6-digit code manually to zerodha_login()
ZERODHA_TOTP_SECRET=

# ── Zerodha KiteConnect (Personal app — free tier) ───────────────────────────
# Create app at: https://kite.trade/connect/login (select "Personal" type)
# Redirect URL must be: https://<your-domain>/kite/callback
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# ── INDmoney / INDstocks API ──────────────────────────────────────────────────
# Get token from: https://indstocks.com dashboard → API section
INDSTOCKS_TOKEN=

# ── Public URL (for OAuth redirect and allowed_hosts) ─────────────────────────
# Set to your deployment domain e.g. https://140-245-202-88.sslip.io
PUBLIC_URL=

# ── Broker backend ─────────────────────────────────────────────────────────────
# zerodha_web  (default) direct httpx to kite.zerodha.com — no extra deps
# jugaad       jugaad-trader fallback — use if Zerodha changes their web API
BROKER_BACKEND=zerodha_web

# ── Session persistence ────────────────────────────────────────────────────────
# Path where the enctoken is saved so restarts don't require re-login.
# The token is valid for ~24 hours (Zerodha resets at 07:30 IST daily).
SESSION_FILE=.session.json

# ── Trade Journal (Turso cloud SQLite) ────────────────────────────────────────
# Leave blank to use local SQLite (journal.db) — set both to use Turso.
# Get these from: turso db show <db-name> --url && turso db tokens create <db-name>
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ── Development toggles (never set true in production) ────────────────────────
# DEV_BYPASS_AUTH=true  — skip OAuth/Bearer auth gate on /sse and /mcp so MCP
#                         clients connect without a token. All tools are exposed.
#                         Existing auth code is completely unchanged when false.
DEV_BYPASS_AUTH=false

# JUGAAD_USE_ENV_CREDENTIALS=true  — auto-login at startup using the credentials
#                         above (ZERODHA_USER_ID + ZERODHA_PASSWORD + ZERODHA_TOTP_SECRET).
#                         TOTP is generated from the secret via pyotp.
#                         Existing manual login flow is unchanged when false.
JUGAAD_USE_ENV_CREDENTIALS=false

# ── Phase 9A — Live Position Monitor (Oracle VM, standalone systemd service) ──
# Bootstraps the single default row in monitor.users on first run.
# Get a CallMeBot API key by messaging the bot per https://www.callmebot.com/blog/free-api-whatsapp-messages/
DEFAULT_USER_NAME=Vishnu
DEFAULT_WHATSAPP_PHONE=91XXXXXXXXXX
DEFAULT_CALLMEBOT_API_KEY=XXXXXX
# Optional second alert channel — Telegram Bot API has no onboarding delay
# (unlike CallMeBot's WhatsApp opt-in handshake), so alerts still land if
# CallMeBot is slow/down. Leave both blank to use CallMeBot only.
# Create a bot via @BotFather, then message it once and read your chat_id
# from https://api.telegram.org/bot<token>/getUpdates
DEFAULT_TELEGRAM_BOT_TOKEN=
DEFAULT_TELEGRAM_CHAT_ID=
PCR_SHIFT_THRESHOLD=0.3
VIX_SPIKE_THRESHOLD=14.0
PROFIT_ALERT_PCT=0.50
