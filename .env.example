# ── Zerodha personal account credentials ──────────────────────────────────────
# Your Zerodha client ID (e.g. ZK1234) and trading password.
# These are only used at login time — never sent to third parties.
ZERODHA_USER_ID=your_client_id
ZERODHA_PASSWORD=your_password

# TOTP — provide ONE of the following:
#   TOTP_SECRET  base32 secret from Zerodha's 2FA QR code (recommended for
#                unattended servers — the server generates the code automatically)
#   Leave blank if you prefer to pass the 6-digit code manually to zerodha_login()
ZERODHA_TOTP_SECRET=

# ── Broker backend ─────────────────────────────────────────────────────────────
# zerodha_web  (default) direct httpx to kite.zerodha.com — no extra deps
# jugaad       jugaad-trader fallback — use if Zerodha changes their web API
BROKER_BACKEND=zerodha_web

# ── Session persistence ────────────────────────────────────────────────────────
# Path where the enctoken is saved so restarts don't require re-login.
# The token is valid for ~24 hours (Zerodha resets at 07:30 IST daily).
SESSION_FILE=.session.json

# ── Trade Journal (Turso cloud SQLite) ────────────────────────────────────────
# Leave blank to use local SQLite (journal.db) — set both to use Turso.
# Get these from: turso db show <db-name> --url && turso db tokens create <db-name>
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ── Development toggles (never set true in production) ────────────────────────
# DEV_BYPASS_AUTH=true  — skip OAuth/Bearer auth gate on /sse and /mcp so MCP
#                         clients connect without a token. All tools are exposed.
#                         Existing auth code is completely unchanged when false.
DEV_BYPASS_AUTH=false

# JUGAAD_USE_ENV_CREDENTIALS=true  — auto-login at startup using the credentials
#                         above (ZERODHA_USER_ID + ZERODHA_PASSWORD + ZERODHA_TOTP_SECRET).
#                         TOTP is generated from the secret via pyotp.
#                         Existing manual login flow is unchanged when false.
JUGAAD_USE_ENV_CREDENTIALS=false
